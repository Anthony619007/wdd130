<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All-Outdoors California Whitewater Rafting</title>
    <!-- google fonts for clean, contemporary typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:opsz@14..32&family=Montserrat:wght@500;700&display=swap"
      rel="stylesheet">
    <!-- Font Awesome 6 (free) for icons & visual appeal -->
    <link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        /* === CSS RESET / BASE === */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #f9fbfd;
            color: #1e2b37;
            line-height: 1.6;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* consistent container / max-width */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 24px;
        }

        /* === TYPOGRAPHY & BRAND === */
        h1,
        h2,
        h3 {
            font-family: 'Montserrat', sans-serif;
            font-weight: 700;
            letter-spacing: -0.02em;
            line-height: 1.2;
        }

        h1 {
            font-size: 2.8rem;
            margin-bottom: 0.5rem;
        }

        h2 {
            font-size: 2.2rem;
            margin-bottom: 1.5rem;
            position: relative;
            display: inline-block;
        }

        h2:after {
            content: '';
            display: block;
            width: 70px;
            height: 4px;
            background: #2a7f62;
            margin-top: 8px;
            border-radius: 4px;
        }

        h3 {
            font-size: 1.6rem;
            margin-bottom: 1rem;
            color: #0f3d3a;
        }

        /* === HEADER & NAVIGATION (consistent, easy nav) === */
        header {
            background: #ffffff;
            box-shadow: 0 6px 18px rgba(0, 40, 30, 0.08);
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .header-flex {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            padding: 16px 0;
        }

        .logo a {
            font-family: 'Montserrat', sans-serif;
            font-size: 1.9rem;
            font-weight: 700;
            color: #0f4c5c;
            text-decoration: none;
            letter-spacing: -0.5px;
        }

        .logo span {
            color: #d97d3b;
            font-weight: 500;
        }

        nav ul {
            display: flex;
            gap: 2rem;
            list-style: none;
            flex-wrap: wrap;
        }

        nav a {
            text-decoration: none;
            font-weight: 600;
            color: #1d3b45;
            font-size: 1.1rem;
            transition: color 0.2s ease;
            padding-bottom: 6px;
            border-bottom: 2px solid transparent;
        }

        nav a:hover,
        nav a:focus {
            color: #2a7f62;
            border-bottom-color: #2a7f62;
        }

        /* active page indicator (simple) */
        .active-page {
            color: #2a7f62;
            border-bottom-color: #2a7f62;
        }

        /* === FOOTER (consistent) === */
        footer {
            background: #142d34;
            color: #e0f0f0;
            margin-top: 4rem;
            padding: 2.5rem 0 1.5rem;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 2rem;
        }

        .footer-col p,
        .footer-col a {
            color: #cbd5d6;
            text-decoration: none;
            font-size: 0.95rem;
        }

        .footer-col a:hover {
            color: white;
        }

        .social-icons {
            margin-top: 1rem;
            font-size: 1.6rem;
            letter-spacing: 0.5rem;
        }

        .copyright {
            text-align: center;
            border-top: 1px solid #2d4e55;
            padding-top: 1.5rem;
            margin-top: 2rem;
            font-size: 0.9rem;
            color: #9bb7bb;
        }

        /* === HERO / CALL TO ACTION SECTION (home) === */
        .hero {
            background: linear-gradient(95deg, #074b4b, #217a6b), url('https://images.unsplash.com/photo-1544551763-46a013bb70d5?q=80&w=2070&auto=format&fit=crop') no-repeat center center/cover;
            background-blend-mode: overlay;
            color: white;
            padding: 5rem 0;
            margin-bottom: 3rem;
            border-radius: 0 0 50px 50px;
            box-shadow: 0 12px 24px rgba(0, 30, 20, 0.3);
        }

        .hero .container {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            max-width: 700px;
        }

        .hero h1 {
            font-size: 3.5rem;
            color: white;
            text-shadow: 0 4px 12px rgba(0, 0, 0, 0.3);
        }

        .hero p {
            font-size: 1.3rem;
            margin: 1.2rem 0 2rem;
            opacity: 0.95;
        }

        .btn {
            display: inline-block;
            background: #d97d3b;
            color: white !important;
            padding: 0.9rem 2.3rem;
            border-radius: 60px;
            font-weight: 700;
            text-decoration: none;
            font-size: 1.2rem;
            box-shadow: 0 6px 14px rgba(0, 0, 0, 0.15);
            transition: all 0.2s;
            border: none;
            cursor: pointer;
        }

        .btn:hover {
            background: #b85f28;
            transform: scale(1.02);
        }

        /* cards & image treatments */
        .card-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 2rem;
            margin: 2.5rem 0;
        }

        .card {
            background: white;
            border-radius: 32px;
            padding: 2rem 1.5rem;
            box-shadow: 0 8px 30px rgba(0, 30, 20, 0.06);
            transition: 0.2s ease;
            border: 1px solid #e2ece9;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 18px 36px -8px rgba(18, 82, 74, 0.15);
        }

        .card i {
            font-size: 2.8rem;
            color: #2a7f62;
            margin-bottom: 1.2rem;
        }

        /* trip cards (more visual) */
        .trip-card {
            background: white;
            border-radius: 40px;
            overflow: hidden;
            box-shadow: 0 12px 30px rgba(0, 40, 30, 0.08);
            display: flex;
            flex-direction: column;
        }

        .trip-card img {
            width: 100%;
            height: 220px;
            object-fit: cover;
        }

        .trip-content {
            padding: 1.8rem 1.5rem;
        }

        .trip-content h3 {
            margin-bottom: 0.5rem;
        }

        .tag {
            background: #d97d3b20;
            color: #b45f2b;
            font-weight: 600;
            font-size: 0.85rem;
            padding: 0.25rem 1rem;
            border-radius: 40px;
            display: inline-block;
            margin-bottom: 0.8rem;
        }

        /* contact form */
        .contact-form {
            background: white;
            border-radius: 40px;
            padding: 2.5rem;
            box-shadow: 0 20px 40px -10px rgba(0, 60, 40, 0.2);
            max-width: 700px;
        }

        .form-group {
            margin-bottom: 1.6rem;
        }

        input,
        textarea {
            width: 100%;
            padding: 1rem 1.2rem;
            border: 1.5px solid #d6e4e0;
            border-radius: 40px;
            font-family: inherit;
            font-size: 1rem;
            transition: 0.2s;
        }

        input:focus,
        textarea:focus {
            outline: none;
            border-color: #2a7f62;
            box-shadow: 0 0 0 4px #9fd1c2;
        }

        textarea {
            border-radius: 30px;
            resize: vertical;
        }

        /* about page staff list */
        .staff-list {
            display: flex;
            flex-wrap: wrap;
            gap: 2.5rem;
            margin-top: 2rem;
        }

        .staff-item {
            background: white;
            border-radius: 30px;
            padding: 1.8rem 1.5rem;
            flex: 1 1 200px;
            text-align: center;
            box-shadow: 0 6px 18px #d0e2db;
        }

        .staff-item i {
            font-size: 3.5rem;
            background: #f0f7f4;
            padding: 1rem;
            border-radius: 60px;
            color: #1f6e5c;
        }

        /* utilities */
        .text-center {
            text-align: center;
        }

        .mt-4 {
            margin-top: 3rem;
        }

        .mb-2 {
            margin-bottom: 1.5rem;
        }

        hr {
            border: none;
            height: 2px;
            background: linear-gradient(to right, #c7e0d7, transparent);
            margin: 2rem 0;
        }

        img {
            max-width: 100%;
            border-radius: 28px;
        }

        .attribution {
            font-size: 0.85rem;
            color: #6f8e8a;
        }
    </style>